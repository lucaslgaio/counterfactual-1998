{
  "_meta": {
    "draft": true,
    "description": "Forma funcional por edge. Parâmetros são DRAFT — calibração real é Etapa 5. Convenção: alpha = coeficiente principal (efeito do source no target), beta = parâmetro secundário (saturation point ou time constant), null = a calibrar.",
    "form_types": {
      "linear": "delta_target = alpha * delta_source",
      "log_linear": "delta_target = alpha * log(1 + source / beta) (retornos decrescentes)",
      "sigmoid": "target_t = beta / (1 + exp(-alpha * (source - midpoint))) (saturação)",
      "exponential_decay": "delta_target = alpha * source * exp(-t / beta) (efeito que fade)",
      "sigmoid_temporal": "Magnitude muda no tempo conforme uma activation_metric cruza um threshold. Antes: alpha_pre. Depois: alpha_post. Captura não-linearidade dose-resposta histórica (e.g., disinformação pré vs pós-2016)."
    }
  },
