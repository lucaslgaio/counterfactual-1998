{
  "_meta": {
    "draft": true,
    "description": "Variantes condicionais para os 16 eventos âncora. Cada evento tem 3-4 variantes com base_probability somando 1.0. Modulators ajustam a probabilidade conforme o estado contrafactual. Validar com pesquisa histórica + literatura sobre IA + segurança/economia/política.",
    "schema": {
      "events": "Lista dos 16 eventos com variantes",
      "delta_packages": "Pacotes de deltas referenciados por delta_package_id",
      "composite_factors": "Fatores compostos usados em modulators (combinações lineares de métricas)"
    }
  },
  "composite_factors": {
    "ai_intelligence_composite_US": {
      "formula": "0.4 * ai_capability.frontier_capability.US + 0.3 * ai_capability.population_penetration.US + 0.3 * governance.ai_regulation_maturity.US",
      "normalization": "divide_by_100",
      "draft": true
    },
    "ai_intelligence_composite_global": {
      "formula": "0.25 * ai_capability.frontier_capability.US + 0.25 * ai_capability.frontier_capability.EU + 0.25 * ai_capability.frontier_capability.CN + 0.25 * ai_capability.frontier_capability.RoW",
      "normalization": "divide_by_100",
      "draft": true
    },
    "financial_fragility": {
      "formula": "financial_markets.systemic_risk - 0.5 * (100 - financial_markets.global_index)",
      "normalization": "divide_by_100",
      "draft": true
    },
    "ai_economic_dependency": {
      "formula": "0.5 * ai_capability.population_penetration.US + 0.3 * tech_industry.bigtech_concentration.US + 0.2 * tech_industry.tech_employment_share.US",
      "normalization": "divide_by_100",
      "draft": true
    },
    "ai_disinfo_capacity": {
      "formula": "ai_capability.frontier_capability.US * (information_ecosystem.disinformation_level.US / 100)",
      "normalization": "divide_by_100",
      "draft": true
    }
  },
